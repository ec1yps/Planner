<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Planner_UI.ViewModels"
    x:Class="Planner_UI.TaskView"
    x:DataType="vm:TaskViewModel"
    WindowStartupLocation="CenterScreen"
    Width="900"
    Height="600"
    Title="Planner">

    <Grid Margin="10"
          RowDefinitions="Auto,*">

        <StackPanel Orientation="Horizontal"
                    Spacing="10">

            <TextBox Width="200"
                     PlaceholderText="Task title"
                     Text="{Binding Title}" />

            <TextBox Width="300"
                     PlaceholderText="Description"
                     Text="{Binding Description}" />

            <Button Content="Add task"
                    Command="{Binding AddTaskCommand}"/>

        </StackPanel>

        <ListBox Grid.Row="1"
                 Margin="0,10,0,0"
                 ItemsSource="{Binding Tasks}">

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <Border Padding="10">

                        <StackPanel>

                            <CheckBox IsChecked="{Binding IsCompleted}"
                                      Command="{Binding $parent[Window].DataContext.ToggleCompletedCommand}"
                                      CommandParameter="{Binding}"/>

                            <TextBlock Text="{Binding Title}"
                                       FontWeight="Bold"
                                       IsVisible="{Binding !IsEditing}"/>

                            <TextBlock Text="{Binding Description}"
                                       IsVisible="{Binding !IsEditing}"/>

                            <TextBox Text="{Binding Title}"
                                     PlaceholderText="Edit title"
                                     IsVisible="{Binding IsEditing}"/>

                            <TextBox Text="{Binding Description}"
                                     PlaceholderText="Edit description"
                                     IsVisible="{Binding IsEditing}"/>

                            <Button Content="Delete"
                                    IsVisible="{Binding !IsEditing}"
                                    Command="{Binding $parent[Window].DataContext.DeleteTaskCommand}"
                                    CommandParameter="{Binding}"/>

                            <Button Content="Edit"
                                    IsVisible="{Binding !IsEditing}"
                                    Command="{Binding $parent[Window].DataContext.EditTaskCommand}"
                                    CommandParameter="{Binding}"/>

                            <Button Content="Save"
                                    IsVisible="{Binding IsEditing}"
                                    Command="{Binding $parent[Window].DataContext.SaveTaskCommand}"
                                    CommandParameter="{Binding}"/>

                            <Button Content="Cancel"
                                    IsVisible="{Binding IsEditing}"
                                    Command="{Binding $parent[Window].DataContext.CancelEditCommand}"
                                    CommandParameter="{Binding}"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>

</Window>